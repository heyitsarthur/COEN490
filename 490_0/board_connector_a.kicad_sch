	(text "Connect pins to flash the eMMC."
		(exclude_from_sim no)
		(at 33.274 192.786 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "545046dd-629e-44b8-8410-0b8a7cf27ac7")
	)
	(text "disable the Ethernet controller in software. Even if the pins are disconnected, the internal hardware is still powered by default.\n\nIn /boot/config.txt (or /boot/firmware/config.txt), add:\n\nPlaintext\ndtparam=eth0=off"
		(exclude_from_sim no)
		(at 14.478 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "66fb00c8-3e40-4b57-91bf-dd6850805435")
	)
	(text "Choose any other available GPIO pin (e.g., GPIO25) \nand configure your system software (using a device \ntree overlay like gpio-shutdown in /boot/config.txt) \nto use that specific pin for a safe shutdown sequence. \nThis avoids conflicts with the dedicated I²C pin\n"
		(exclude_from_sim no)
		(at -66.04 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b5381f91-a75b-4349-94ca-2cd8831f49fb")
	)
	(text "Run: sudo nano /boot/config.txt\n\nScroll to the bottom and add this line: \ndtoverlay=gpio-shutdown,gpio_pin=17,active_low=1,gpio_pull=up"
		(exclude_from_sim no)
		(at 151.892 106.426 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "b9dcbd1f-5b7e-4d7a-9d0f-45ad9225fc29")
	)
