	(text "Keeps the switch always active."
		(exclude_from_sim no)
		(at 213.36 103.886 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2090de31-0866-4f7a-8c20-f70415d65c70")
	)
	(text "Low (0V): Path 1 (Flash)\nHigh (3.3V): Path 2 (Hub)"
		(exclude_from_sim no)
		(at 228.346 71.882 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "706c6396-7975-4b26-a1bb-6804b95cf98d")
	)
	(text "USB Power Source: \nUse a high-quality 5V/3A (15W) wall adapter. \nIf we use a weak 1A phone charger, \nthe device will charge very slowly or the Pi might reboot."
		(exclude_from_sim no)
		(at 18.542 94.996 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 255 0 0 1)
			)
			(justify left)
		)
		(uuid "b04230f0-de62-4349-92cf-abaa735b87b7")
	)
	(text "A standard USB-C receptacle has VBUS pins on both \nthe top row (A4, A9) and bottom row (B4, B9). \nThis ensures that no matter which way you flip the cable,\n the power pins always align. (Same for ground)"
		(exclude_from_sim no)
		(at 127.508 69.596 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e88eab6d-27cb-468e-9f53-5b92f72caf58")
	)
