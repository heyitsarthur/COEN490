		(uuid "2de54e07-c6c8-4d78-9aaf-d5eb30ea7f31")
	)
	(text "break this pin out to a test point on your PCB. \nDuring your initial testing, you can use a multimeter \nto measure the voltage and calculate exactly how much \n\"fuel\" your robot is consuming without having to cut \nwires to insert an ammeter."
		(exclude_from_sim no)
		(at 14.478 169.164 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "660172e7-640f-4fa2-a631-46f73e372569")
	)
	(text "Charge Current - ISET - 215 kΩ = 1A\nInput Limit - ILIM - 71.5 kΩ = 3A Limit from USB (Safe for most adapters)\nDischarge Limit - OLIM - 43 kΩ = 4.9A Limit\nLogic Pull-up - ACOK - 10 kΩ (Standard Pull-up)\nTemp Fake (High),VNTC to NTC,10 kΩ,Part 1 of Voltage Divider\nTemp Fake (Low),NTC to AGND,10 kΩ,Part 2 of Voltage Divider"
		(exclude_from_sim no)
		(at 139.954 167.132 0)
		(effects
