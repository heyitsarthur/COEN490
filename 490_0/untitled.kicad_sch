	(text "OCSx: Internally pulled up\nENx: Push Pull 12mA"
		(exclude_from_sim no)
		(at 162.56 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "50445709-624d-4825-a832-5acd8563f8f2")
	)
	(text "The official CM4 IO board uses 10 µF for the AP22653W6 for the same reason. \nSince the TPS2553 and the AP22653 are functionally and pin-compatible \n\"High-Side Switches,\" the input requirements are identical. \nUsing 10 µF ensures that the \"inrush\" current of the switch itself \ndoesn't cause a momentary voltage drop on the CM4's main 5V rail."
		(exclude_from_sim no)
		(at 312.42 35.56 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "bae9e078-593c-4308-9919-0edd8e53bdb1")
	)
